<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<link href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" rel="stylesheet">
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Advices</h3>
            <div class="card-tools">
                <a href="/backoffice/addadvice" class="btn btn-primary"><i class="fas fa-plus"></i>Add
                    Advices</a>
            </div>
        </div>
        <div class="card-body">
            <table id="myTable" class="display table table-striped projects">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Topic</th>
                        <th>Image</th>
                        <th>Advice</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Les lignes seront insérées ici via JavaScript -->
                </tbody>
            </table>
        </div>
    </div>
</section>



<!-- View/Edit Modal -->
<!-- View/Edit Modal -->
<div class="modal fade" id="adviceModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Advice Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="adviceForm">
                    <input type="hidden" id="adviceId">
                    <div class="form-group">
                        <label>Topic</label>
                        <input type="text" id="adviceTopic" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Advice</label>
                        <textarea id="adviceAdviceText" class="form-control" required></textarea>
                    </div>
                    <div class="form-group">
                        <label>Image</label>
                        <input type="file" class="form-control"
                            name="photo" id="newPhoto">
                        <div id="adviceImage">
                            <!-- Image preview will go here -->
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        axios.get('/api/getalladvices')
            .then(response => {
                const data = response.data;
                const tableBody = document.querySelector('#myTable tbody');
                tableBody.innerHTML = '';

                data.forEach(advice => {
                    const row = `
                    <tr>
                        <td>${advice.id}</td>
                        <td>${advice.topic}</td>
                        <td><img src="/uploads/advices/${advice.photo}" width="50" height="50" alt="Image"></td>
                        <td>${advice.advice_text}</td>
                        <td>
                            <button class="btn btn-primary btn-sm view-btn" data-id="${advice.id}">Edit</button>
                            <button class="btn btn-danger btn-sm delete-btn" data-id="${advice.id}">Delete</button>
                        </td>
                    </tr>`;
                    tableBody.innerHTML += row;
                });

                // Initialize DataTable
                $('#myTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json"
                    }
                });
            })
            .catch(error => console.error('Error fetching advices:', error));

        // View advice details in modal
        document.body.addEventListener('click', function (e) {
            if (e.target.classList.contains('view-btn')) {
                const id = e.target.dataset.id;
                axios.get(`/api/getadvice/${id}`)
                    .then(response => {
                        const advice = response.data;
                        document.getElementById('adviceId').value = advice.id;
                        document.getElementById('adviceTopic').value = advice.topic;
                        document.getElementById('adviceAdviceText').value = advice.advice_text;

                        // Display the current image in the modal
                        const imageUrl = `/uploads/advices/${advice.photo}`;
                        document.getElementById('adviceImage').innerHTML = `
                    <img src="${imageUrl}" width="100" height="100" alt="Advice Image" class="img-thumbnail">
                    <p>Current Image</p>
                `;

                        $('#adviceModal').modal('show');
                    })
                    .catch(error => console.error('Error fetching advice:', error));
            }
        });

        // Update advice
        document.getElementById('adviceForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const id = document.getElementById('adviceId').value;
            const data = {
                topic: document.getElementById('adviceTopic').value,
                advice_text: document.getElementById('adviceAdviceText').value,
                photo: document.getElementById('newPhoto').files[0]
            };

            axios.put(`/api/updateadvice/${id}`, data, {
                headers: {
                    'Content-Type': 'multipart/form-data'
                }
            })
                .then(() => {
                    $('#adviceModal').modal('hide');
                    location.reload();
                })
                .catch(error => console.error('Error updating advice:', error));
        });

        // Delete advice
        document.body.addEventListener('click', function (e) {
            if (e.target.classList.contains('delete-btn')) {
                const id = e.target.dataset.id;
                if (confirm('Are you sure you want to delete this advice?')) {
                    axios.delete(`/api/deleteadvice/${id}`)
                        .then(() => location.reload())
                        .catch(error => console.error('Error deleting advice:', error));
                }
            }
        });
    });
</script>