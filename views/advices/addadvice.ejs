<div class="row">
  <section class="content">
    <div class="row">
      <div class="col p-5">
        <div class="card card-primary p-4">
          <h3>Ajouter Conseil</h3>
          <div class="card-body">
            <form id="adviceForm">
              <div class="form-group mb-3">
                <label for="nom">Sujet</label>
                <input type="text" class="form-control" name="topic" id="nom"
                  required />
              </div>
              <div class="form-group mb-3">
                <label for="nom">Sujet Anglais</label>
                <input type="text" class="form-control" name="topic_en" id="nom"
                  required />
              </div>
              <div class="form-group mb-3">
                <label for="description">Conseil</label>
                <textarea class="form-control" name="advice_text"
                  id="description" required></textarea>
              </div>
              <div class="form-group mb-3">
                <label for="description">Conseil Anglais</label>
                <textarea class="form-control" name="advice_text_en"
                  id="description" required></textarea>
              </div>
              <div class="form-group mb-3">
                <label for="photo">Photo</label>
                <input type="file" class="form-control" name="photo"
                  id="photo" />
              </div>
              <button type="submit" class="btn btn-primary">Ajouter Conseil</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  // Récupérer le formulaire
  const form = document.getElementById('adviceForm');  // Ajout de la récupération du formulaire

  form.addEventListener('submit', async (event) => {
    event.preventDefault();  // Empêcher la soumission classique du formulaire

    const formData = new FormData(form);

    // Log les données du formulaire avant de les envoyer
    console.log('FormData:', [...formData.entries()]);

    try {
      const response = await axios.post('/api/addadvice', formData, {
        headers: {
          'Content-Type': 'multipart/form-data'
        }
      });

      console.log('Réponse de l\'API:', response);
      if (response.status === 201) {
        alert(response.data.message);  // Afficher un message de succès
        window.location.href = '/backoffice/listadvices';
        form.reset();  // Réinitialiser le formulaire
      } else {
        alert('Error: ' + response.data.message);  // Afficher un message d'erreur
      }
    } catch (error) {
      console.log('Erreur lors de l\'ajout du témoignage:', error.response || error);
      alert('Erreur lors de l\'ajout du témoignage');
    }
  });
</script>