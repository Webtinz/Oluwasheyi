<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<link href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" rel="stylesheet">
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Feedback</h3>
        </div>
        <div class="card-body">
            <table id="myTable" class="display table table-striped projects">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>
                            Nom
                        </th>
                        <th>Email</th>
                        <th>Suggestions</th>
                        <th>Experience </th>
                        <th>
                            Date
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Les lignes seront insérées ici via JavaScript -->
                </tbody>
            </table>
        </div>
    </div>
</section>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        axios.get('/api/getallfeedbacks')
            .then(response => {
                const data = response.data;
                const tableBody = document.querySelector('#myTable tbody');
                tableBody.innerHTML = '';

                data.forEach(feedback => {
                    const experienceStars = '★'.repeat(feedback.experience) + '☆'.repeat(5 - feedback.experience);
                    console.log("experienceStars", feedback.experience)
                    const formattedDate = new Date(feedback.createdAt).toLocaleDateString('fr-FR');
                    const row = `
                    <tr>
                        <td>${feedback.id}</td>
                        <td>${feedback.name}</td>
                         <td>${feedback.email}</td>
                        <td>${feedback.yoursuggestions}</td>
                        <td>${experienceStars}</td>
                        <td>${formattedDate}</td>
                    </tr>`;
                    tableBody.innerHTML += row;
                });

                // Initialize DataTable
                $('#myTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json"
                    }
                });
            })
            .catch(error => console.error('Error fetching Feedback:', error));
    });
</script>