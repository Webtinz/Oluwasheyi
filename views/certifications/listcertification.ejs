<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css"
    rel="stylesheet">
<script
    src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Certifications</h3>
            <div class="card-tools">
                <a href="/backoffice/addcertification"
                    class="btn btn-primary"><i class="fas fa-plus"></i> Ajouter
                    une certification</a>
            </div>
        </div>
        <div class="card-body">
            <table id="certificationTable"
                class="display table table-striped projects">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom de la certification</th>
                        <th>Description</th>
                        <th>Date d'obtention</th>
                        <th>Photo</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Les lignes seront insérées ici via JavaScript -->
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- View/Edit Modal -->
<div class="modal fade" id="certificationModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Détails de la certification</h5>
                <button type="button" class="close" data-dismiss="modal"
                    aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="certificationForm">
                    <input type="hidden" id="certificationId">
                    <div class="form-group">
                        <label>Nom de la certification</label>
                        <input type="text" id="certificationName"
                            class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Date d'Obtention</label>
                        <input type="date" id="certificationdateobtention"
                            class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <textarea id="certificationDescription"
                            class="form-control" required></textarea>
                    </div>
                    <div class="form-group">
                        <label>Photo</label>
                        <input type="file" id="certificationPhoto"
                            class="form-control">
                        <img id="currentCertificationPhoto" src="#"
                            alt="Photo de la certification" width="100"
                            style="margin-top: 10px; display: none;">
                    </div>
                    <button type="submit"
                        class="btn btn-primary">Enregistrer</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Récupérer toutes les certifications et afficher dans le tableau
        axios.get('/api/getallcertifications')
            .then(response => {
                const data = response.data;
                const tableBody = document.querySelector('#certificationTable tbody');
                tableBody.innerHTML = '';

                data.forEach(certification => {
                    const row = `
                    <tr>
                        <td>${certification.id}</td>
                        <td>${certification.name}</td>
                        <td>${certification.description}</td>
                        <td>${certification.date_obtention}</td>
                        <td><img src="${certification.photo}" width="50" height="50" alt="Photo de la certification"></td>
                        <td>
                            <button class="btn btn-primary btn-sm view-btn" data-id="${certification.id}">Edit</button>
                            <button class="btn btn-danger btn-sm delete-btn" data-id="${certification.id}">Delete</button>
                        </td>
                    </tr>`;
                    tableBody.innerHTML += row;
                });

                // Initialiser DataTable
                $('#certificationTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json"
                    }
                });
            })
            .catch(error => console.error('Erreur lors de la récupération des certifications :', error));

        // Clic sur le bouton "Modifier"
        $(document).on('click', '.view-btn', function () {
            const id = $(this).data('id');
            axios.get(`/api/getcertification/${id}`)
                .then(response => {
                    const certification = response.data;
                    $('#certificationId').val(certification.id);
                    $('#certificationName').val(certification.name);
                    $('#certificationDescription').val(certification.description);
                    $('#certificationdateobtention').val(certification.date_obtention);
                    const photoElement = $('#currentCertificationPhoto');
                    if (certification.photo) {
                        photoElement.attr('src', `${certification.photo}`).show();
                    } else {
                        photoElement.hide();
                    }
                    $('#certificationModal').modal('show');
                })
                .catch(error => console.error('Erreur lors de la récupération de la certification :', error));
        });

        // Mettre à jour la certification
        $('#certificationForm').on('submit', function (e) {
            e.preventDefault();
            const id = $('#certificationId').val();
            const formData = new FormData();
            formData.append('name', $('#certificationName').val());
            formData.append('description', $('#certificationDescription').val());
            formData.append('date_obtention', $('#certificationdateobtention').val());
            if ($('#certificationPhoto')[0].files[0]) {
                formData.append('photo', $('#certificationPhoto')[0].files[0]);
            }

            axios.put(`/api/updatecertification/${id}`, formData)
                .then(() => {
                    $('#certificationModal').modal('hide');
                    location.reload();
                })
                .catch(error => console.error('Erreur lors de la mise à jour de la certification :', error));
        });

        // Clic sur le bouton "Supprimer"
        $(document).on('click', '.delete-btn', function () {
            const id = $(this).data('id');
            if (confirm('Voulez-vous vraiment supprimer cette certification ?')) {
                axios.delete(`/api/deletecertification/${id}`)
                    .then(() => location.reload())
                    .catch(error => console.error('Erreur lors de la suppression de la certification :', error));
            }
        });
    });
</script>
