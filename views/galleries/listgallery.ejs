<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css"
    rel="stylesheet">
<script
    src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Gallerys</h3>
            <div class="card-tools">
                <a href="/backoffice/addgallery"
                    class="btn btn-primary"><i class="fas fa-plus"></i> Ajouter
                    une gallery</a>
            </div>
        </div>
        <div class="card-body">
            <table id="galleryTable"
                class="display table table-striped projects">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom de la gallery</th>
                        <th>Description</th>
                        <th>Photo</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Les lignes seront insérées ici via JavaScript -->
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- View/Edit Modal -->
<div class="modal fade" id="galleryModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Détails de la gallery</h5>
                <button type="button" class="close" data-dismiss="modal"
                    aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="galleryForm">
                    <input type="hidden" id="galleryId">
                    <div class="form-group">
                        <label>Nom de la gallery</label>
                        <input type="text" id="galleryName"
                            class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <textarea id="galleryDescription"
                            class="form-control" required></textarea>
                    </div>
                    <div class="form-group">
                        <label>Photo</label>
                        <input type="file" id="galleryPhoto"
                            class="form-control">
                        <img id="currentGalleryPhoto" src="#"
                            alt="Photo de la gallery" width="100"
                            style="margin-top: 10px; display: none;">
                    </div>
                    <button type="submit"
                        class="btn btn-primary">Enregistrer</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Récupérer toutes les galleries et afficher dans le tableau
        axios.get('/api/getallgalleries')
            .then(response => {
                const data = response.data;
                const tableBody = document.querySelector('#galleryTable tbody');
                tableBody.innerHTML = '';

                data.forEach(gallery => {
                    const row = `
                    <tr>
                        <td>${gallery.id}</td>
                        <td>${gallery.name}</td>
                        <td>${gallery.description}</td>
                        <td><img src="${gallery.photo}" width="50" height="50" alt="Photo de la gallery"></td>
                        <td>
                            <button class="btn btn-primary btn-sm view-btn" data-id="${gallery.id}">Edit</button>
                            <button class="btn btn-danger btn-sm delete-btn" data-id="${gallery.id}">Delete</button>
                        </td>
                    </tr>`;
                    tableBody.innerHTML += row;
                });

                // Initialiser DataTable
                $('#galleryTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json"
                    }
                });
            })
            .catch(error => console.error('Erreur lors de la récupération des galleries :', error));

        // Clic sur le bouton "Modifier"
        $(document).on('click', '.view-btn', function () {
            const id = $(this).data('id');
            axios.get(`/api/getgallery/${id}`)
                .then(response => {
                    const gallery = response.data;
                    $('#galleryId').val(gallery.id);
                    $('#galleryName').val(gallery.name);
                    $('#galleryDescription').val(gallery.description);
                    const photoElement = $('#currentGalleryPhoto');
                    if (gallery.photo) {
                        photoElement.attr('src', `${gallery.photo}`).show();
                    } else {
                        photoElement.hide();
                    }
                    $('#galleryModal').modal('show');
                })
                .catch(error => console.error('Erreur lors de la récupération de la gallery :', error));
        });

        // Mettre à jour la gallery
        $('#galleryForm').on('submit', function (e) {
            e.preventDefault();
            const id = $('#galleryId').val();
            const formData = new FormData();
            formData.append('name', $('#galleryName').val());
            formData.append('description', $('#galleryDescription').val());
            if ($('#galleryPhoto')[0].files[0]) {
                formData.append('photo', $('#galleryPhoto')[0].files[0]);
            }

            axios.put(`/api/updategallery/${id}`, formData)
                .then(() => {
                    $('#galleryModal').modal('hide');
                    location.reload();
                })
                .catch(error => console.error('Erreur lors de la mise à jour de la gallery :', error));
        });

        // Clic sur le bouton "Supprimer"
        $(document).on('click', '.delete-btn', function () {
            const id = $(this).data('id');
            if (confirm('Voulez-vous vraiment supprimer cette gallery ?')) {
                axios.delete(`/api/deletegallery/${id}`)
                    .then(() => location.reload())
                    .catch(error => console.error('Erreur lors de la suppression de la gallery :', error));
            }
        });
    });
</script>
