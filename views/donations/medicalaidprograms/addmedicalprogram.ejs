<div class="row">
    <section class="content">
      <div class="row">
        <div class="col p-5">
          <div class="card card-primary p-4">
            <h3>Nouveau Programme d'aide médicale</h3>
            <div class="card-body">
              <form id="programForm">
                <div class="form-group mb-3">
                  <label for="name">Nom du Programme</label>
                  <input type="text" class="form-control" name="nom" id="name" required />
                </div>
                <div class="form-group mb-3">
                  <label for="name">Nom du Programme (Anglais)</label>
                  <input type="text" class="form-control" name="name" id="name" required />
                </div>
                <div class="form-group mb-3">
                  <label for="contact">Contact</label>
                  <input type="tel" class="form-control" name="contact" id="contact" required />
                </div>
                <div class="form-group mb-3">
                  <label for="description">Description</label>
                  <textarea class="form-control" name="description" id="description" required></textarea>
                </div>
                <div class="form-group mb-3">
                  <label for="description">Description (Anglais)</label>
                  <textarea class="form-control" name="description_en" id="description" required></textarea>
                </div>
                <div class="form-group mb-3">
                  <label for="beneficiaries">beneficiaires du Programme</label>
                  <input type="tel" class="form-control" name="beneficiaries" id="beneficiaries" required />
                </div>
                <div class="form-group mb-3">
                  <label for="photo">Photo</label>
                  <input type="file" class="form-control" name="photo" id="photo" />
                </div>
                <button type="submit" class="btn btn-primary">Ajouter Programme d'aide médicale</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
  
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script>
    // Récupérer le formulaire
    const form = document.getElementById('programForm');  // Ajout de la récupération du formulaire
  
    form.addEventListener('submit', async (event) => {
      event.preventDefault();  // Empêcher la soumission classique du formulaire
  
      const formData = new FormData(form);
  
      try {
        const response = await axios.post('/api/addprogram', formData, {
          headers: {
            'Content-Type': 'multipart/form-data'
          }
        });
  
        console.log('Réponse de l\'API:', response);
        if (response.status === 201) {
          alert(response.data.message);  // Afficher un message de succès
          window.location.href = '/backoffice/listmedicalprogram';
          form.reset();  // Réinitialiser le formulaire
        } else {
          alert('Error: ' + response.data.message);  // Afficher un message d'erreur
        }
      } catch (error) {
        console.log('Erreur lors de l\'ajout du programme:', error.response || error);
        alert('Erreur lors de l\'ajout du programme');
      }
    });
  </script>