
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<link href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css"
    rel="stylesheet">
<script
    src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Services</h3>
            <div class="card-tools">
                <a href="/backoffice/addservice" class="btn btn-primary"><i
                        class="fas fa-plus"></i> Ajouter un Service</a>
            </div>
        </div>
        <div class="card-body">
            <table id="serviceTable"
                class="display table table-striped projects">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>
                            Nom
                        </th>
                        <th>
                            Nom Anglais
                        </th>
                        <th>
                            Telephone
                        </th>
                        <th>Email</th>
                        <th> Description</th>
                        <th> Description Anglaise</th>
                        <th>Petite Photo</th>
                        <th>Grande Photo</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Les lignes seront insérées ici via JavaScript -->
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- View/Edit Modal -->
<div class="modal fade" id="serviceModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Details du service
                </h5>
                <button type="button" class="close" data-dismiss="modal"
                    aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="serviceForm">
                    <input type="hidden" id="serviceId">
                    <div class="form-group">
                        <label>
                            Nom
                        </label>
                        <input type="text" id="serviceName" class="form-control"
                            required>
                    </div>
                    <div class="form-group">
                        <label>
                            Nom Anglais
                        </label>
                        <input type="text" id="serviceNameEn"
                            class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>
                            Telephone
                        </label>
                        <input type="text" id="servicePhone"
                            class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" id="serviceEmail"
                            class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <textarea id="serviceDescription" class="form-control"
                            required></textarea>
                    </div>
                    <div class="form-group">
                        <label>
                            Description Anglaise
                        </label>
                        <textarea id="serviceDescriptionEn" class="form-control"
                            required></textarea>
                    </div>
                    <div class="form-group">
                        <label>Petite Photo</label>
                        <input type="file" id="serviceSmallPhoto"
                            class="form-control">
                        <img id="currentSmallPhoto" width="100"
                            style="margin-top: 10px; display: none;">
                    </div>
                    <div class="form-group">
                        <label>Grande Photo</label>
                        <input type="file" id="serviceBigPhoto"
                            class="form-control">
                        <img id="currentBigPhoto" width="100"
                            style="margin-top: 10px; display: none;">
                    </div>
                    <button type="submit" class="btn btn-primary">
                        Enregistrer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        axios.get('/api/getallservices')
            .then(response => {
                const data = response.data;
                const tableBody = document.querySelector('#serviceTable tbody');
                tableBody.innerHTML = '';

                data.forEach(service => {
                    const row = `
                    <tr>
                        <td>${service.id}</td>
                        <td>${service.nom}</td>
                        <td>${service.nom_en}</td>
                        <td>${service.phone}</td>
                        <td>${service.email}</td>
                        <td>${service.description}</td>
                        <td>${service.description_en}</td>
                        <td>
                            <img src="${service.smallPhoto}" width="50" height="50" style="margin: 2px;" alt="Department Small Photo">
                        </td>
                        <td>
                            <img src="${service.bigPhoto}" width="50" height="50" style="margin: 2px;" alt="Department Big Photo">
                        </td>
                        <td>
                            <button class="btn btn-primary btn-sm view-btn" data-id="${service.id}">Edit</button>
                            <button class="btn btn-danger btn-sm delete-btn" data-id="${service.id}">Delete</button>
                        </td>
                    </tr>`;
                    tableBody.innerHTML += row;
                });

                // Initialize DataTable
                $('#serviceTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json"
                    }
                });
            })
            .catch(error => console.error('Error fetching services:', error));

        // View service details in modal
        document.body.addEventListener('click', function (e) {
            if (e.target.classList.contains('view-btn')) {
                const id = e.target.dataset.id;
                axios.get(`/api/getservice/${id}`)
                    .then(response => {
                        const service = response.data;
                        document.getElementById('serviceId').value = service.id;
                        document.getElementById('serviceName').value = service.nom;
                        document.getElementById('serviceNameEn').value = service.nom_en;
                        document.getElementById('servicePhone').value = service.phone;
                        document.getElementById('serviceEmail').value = service.email;
                        document.getElementById('serviceDescription').value = service.description;
                        document.getElementById('serviceDescriptionEn').value = service.description_en;
                        
                        const photoElement = $('#currentSmallPhoto');
                        const photoElementBig = $('#currentBigPhoto');
                        if (service.smallPhoto) {
                        photoElement.attr('src', `${service.smallPhoto}`).show();
                        } else {
                        photoElement.hide();
                        }
                        if (service.bigPhoto) {
                        photoElementBig.attr('src', `${service.bigPhoto}`).show();
                        } else {
                        photoElementBig.hide();
                        }       

                        $('#serviceModal').modal('show');
                    })
                    .catch(error => console.error('Error fetching service:', error));
            }
        });

        // Update service
        document.getElementById('serviceForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const id = document.getElementById('serviceId').value;
            const formData = new FormData();
            formData.append('nom', document.getElementById('serviceName').value);
            formData.append('nom_en', document.getElementById('serviceNameEn').value);
            formData.append('phone', document.getElementById('servicePhone').value);
            formData.append('email', document.getElementById('serviceEmail').value);
            formData.append('description', document.getElementById('serviceDescription').value);
            formData.append('description_en', document.getElementById('serviceDescriptionEn').value);
            
            if ($('#serviceSmallPhoto')[0].files[0]) {
                formData.append('smallPhoto', $('#serviceSmallPhoto')[0].files[0]);
            }
            if ($('#serviceBigPhoto')[0].files[0]) {
                formData.append('bigPhoto', $('#serviceBigPhoto')[0].files[0]);
            }

            axios.put(`/api/updateservice/${id}`, formData)
                .then(() => {
                    $('#serviceModal').modal('hide');
                    location.reload();
                })
                .catch(error => console.error('Error updating service:', error));
        });

        // Delete service
        document.body.addEventListener('click', function (e) {
            if (e.target.classList.contains('delete-btn')) {
                const id = e.target.dataset.id;
                if (confirm('Are you sure you want to delete this service?')) {
                    axios.delete(`/api/deleteservice/${id}`)
                        .then(() => location.reload())
                        .catch(error => console.error('Error deleting service:', error));
                }
            }
        });
    });
</script>
