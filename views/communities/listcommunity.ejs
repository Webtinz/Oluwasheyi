<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<link href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css"
    rel="stylesheet">
<script
    src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Communautés</h3>
            <div class="card-tools">
                <a href="/backoffice/addcommunity" class="btn btn-primary"><i
                        class="fas fa-plus"></i>
                        Ajouter
                    Communautés</a>
            </div>
        </div>
        <div class="card-body">
            <table id="myTable" class="display table table-striped projects">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Titre</th>
                        <th>Titre Anglais</th>
                        <th>Image</th>
                        <th>Description</th>
                        <th>Description Anglais</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Les lignes seront insérées ici via JavaScript -->
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- View/Edit Modal -->
<!-- View/Edit Modal -->
<div class="modal fade" id="communityModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Community Details</h5>
                <button type="button" class="close" data-dismiss="modal"
                    aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="communityForm">
                    <input type="hidden" id="communityId">
                    <div class="form-group">
                        <label>Titre</label>
                        <input type="text" id="communityTitre"
                            class="form-control"
                            required>
                    </div>
                    <div class="form-group">
                        <label>Titre Anglais</label>
                        <input type="text" id="communityTitreEn"
                            class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Community</label>
                        <textarea id="communityDescription" class="form-control"
                            required></textarea>
                    </div>
                    <div class="form-group">
                        <label>Community Anglais</label>
                        <textarea id="communityDescriptionEn"
                            class="form-control"
                            required></textarea>
                    </div>
                    <div class="form-group">
                        <label>Image</label>
                        <input type="file" class="form-control"
                            name="photo" id="newPhoto">
                        <div id="communityImage">
                            <!-- Image preview will go here -->
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        Enregistrer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        axios.get('/api/getallcommunities')
            .then(response => {
                const data = response.data;
                const tableBody = document.querySelector('#myTable tbody');
                tableBody.innerHTML = '';

                data.forEach(community => {
                    const row = `
                    <tr>
                        <td>${community.id}</td>
                        <td>${community.title}</td>
                        <td>${community.title_en}</td>
                        <td><img src="${community.photo}" width="50" height="50" alt="Image"></td>
                        <td>${community.description}</td>
                        <td>${community.description_en}</td>
                        <td>
                            <button class="btn btn-primary btn-sm view-btn" data-id="${community.id}">Editer</button>
                            <button class="btn btn-danger btn-sm delete-btn" data-id="${community.id}">Supprimer</button>
                        </td>
                    </tr>`;
                    tableBody.innerHTML += row;
                });

                // Initialize DataTable
                $('#myTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json"
                    }
                });
            })
            .catch(error => console.error('Error fetching communities:', error));

        // View community details in modal
        document.body.addEventListener('click', function (e) {
            if (e.target.classList.contains('view-btn')) {
                const id = e.target.dataset.id;
                axios.get(`/api/getcommunity/${id}`)
                    .then(response => {
                        const community = response.data;
                        document.getElementById('communityId').value = community.id;
                        document.getElementById('communityTitre').value = community.title;
                        document.getElementById('communityTitreEn').value = community.title_en;
                        document.getElementById('communityDescription').value = community.description;
                        document.getElementById('communityDescriptionEn').value = community.description_en;

                        // Display the current image in the modal
                        const imageUrl = `${community.photo}`;
                        document.getElementById('communityImage').innerHTML = `
                    <img src="${imageUrl}" width="100" height="100" alt="Community Image" class="img-thumbnail">
                    <p>Current Image</p>
                `;

                        $('#communityModal').modal('show');
                    })
                    .catch(error => console.error('Error fetching community:', error));
            }
        });

        // Update community
        document.getElementById('communityForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const id = document.getElementById('communityId').value;
            const data = {
                title: document.getElementById('communityTitre').value,
                title_en: document.getElementById('communityTitreEn').value,
                description: document.getElementById('communityDescription').value,
                description_en: document.getElementById('communityDescriptionEn').value,
                photo: document.getElementById('newPhoto').files[0]
            };

            axios.put(`/api/updatecommunity/${id}`, data, {
                headers: {
                    'Content-Type': 'multipart/form-data'
                }
            })
                .then(() => {
                    $('#communityModal').modal('hide');
                    location.reload();
                })
                .catch(error => console.error('Error updating community:', error));
        });

        // Delete community
        document.body.addEventListener('click', function (e) {
            if (e.target.classList.contains('delete-btn')) {
                const id = e.target.dataset.id;
                if (confirm('Etes-vous sûr de vouloir supprimer cette communauté ?')) {
                    axios.delete(`/api/deletecommunity/${id}`)
                        .then(() => location.reload())
                        .catch(error => console.error('Error deleting community:', error));
                }
            }
        });
    });
</script>