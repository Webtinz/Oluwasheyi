<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<link href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" rel="stylesheet">
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">TeamMembers</h3>
            <div class="card-tools">
                <a href="/backoffice/addteamMember" class="btn btn-primary"><i class="fas fa-plus"></i>Add
                    TeamMembers</a>
            </div>
        </div>
        <div class="card-body">
            <table id="myTable" class="display table table-striped projects">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Image</th>
                        <th>Titre</th>
                        <th>Descritions</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Les lignes seront insérées ici via JavaScript -->
                </tbody>
            </table>
        </div>
    </div>
</section>



<!-- View/Edit Modal -->
<!-- View/Edit Modal -->
<div class="modal fade" id="teamMemberModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">TeamMember Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="teamMemberForm">
                    <input type="hidden" id="teamMemberId">
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text" id="teamMemberName" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Title</label>
                        <input type="text" id="teamMemberTitle" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <textarea id="teamMemberDescription" class="form-control" required></textarea>
                    </div>
                    <div class="form-group">
                        <label>Image</label>
                        <input type="file" class="form-control"
                            name="photo" id="newPhoto">
                        <div id="teamMemberImage">
                            <!-- Image preview will go here -->
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        axios.get('/api/getallteamMembers')
            .then(response => {
                const data = response.data;
                const tableBody = document.querySelector('#myTable tbody');
                tableBody.innerHTML = '';

                data.forEach(teamMember => {
                    const row = `
                    <tr>
                        <td>${teamMember.id}</td>
                        <td>${teamMember.nom} ${teamMember.prenom}</td>
                        <td><img src="/uploads/members/${teamMember.photo}" width="50" height="50" alt="Image"></td>
                        <td>${teamMember.titre}</td>
                        <td>${teamMember.description}</td>
                        <td>
                            <button class="btn btn-primary btn-sm view-btn" data-id="${teamMember.id}">Edit</button>
                            <button class="btn btn-danger btn-sm delete-btn" data-id="${teamMember.id}">Delete</button>
                        </td>
                    </tr>`;
                    tableBody.innerHTML += row;
                });

                // Initialize DataTable
                $('#myTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json"
                    }
                });
            })
            .catch(error => console.error('Error fetching teamMembers:', error));

        // View teamMember details in modal
        document.body.addEventListener('click', function (e) {
            if (e.target.classList.contains('view-btn')) {
                const id = e.target.dataset.id;
                axios.get(`/api/getteamMember/${id}`)
                    .then(response => {
                        const teamMember = response.data;
                        document.getElementById('teamMemberId').value = teamMember.id;
                        document.getElementById('teamMemberName').value = teamMember.nom + ' ' + teamMember.prenom;
                        document.getElementById('teamMemberTitle').value = teamMember.titre;
                        document.getElementById('teamMemberDescription').value = teamMember.description;

                        // Display the current image in the modal
                        const imageUrl = `/uploads/members/${teamMember.photo}`;
                        document.getElementById('teamMemberImage').innerHTML = `
                    <img src="${imageUrl}" width="100" height="100" alt="TeamMember Image" class="img-thumbnail">
                    <p>Current Image</p>
                `;

                        $('#teamMemberModal').modal('show');
                    })
                    .catch(error => console.error('Error fetching teamMember:', error));
            }
        });

        // Update teamMember
        document.getElementById('teamMemberForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const id = document.getElementById('teamMemberId').value;
            const data = {
                nom: document.getElementById('teamMemberName').value.split(' ')[0],
                prenom: document.getElementById('teamMemberName').value.split(' ')[1],
                titre: document.getElementById('teamMemberTitle').value,
                description: document.getElementById('teamMemberDescription').value,
                photo: document.getElementById('newPhoto').files[0]
            };

            axios.put(`/api/updateteamMember/${id}`, data, {
                headers: {
                    'Content-Type': 'multipart/form-data'
                }
            })
                .then(() => {
                    $('#teamMemberModal').modal('hide');
                    location.reload();
                })
                .catch(error => console.error('Error updating teamMember:', error));
        });

        // Delete teamMember
        document.body.addEventListener('click', function (e) {
            if (e.target.classList.contains('delete-btn')) {
                const id = e.target.dataset.id;
                if (confirm('Are you sure you want to delete this teamMember?')) {
                    axios.delete(`/api/deleteteamMember/${id}`)
                        .then(() => location.reload())
                        .catch(error => console.error('Error deleting teamMember:', error));
                }
            }
        });
    });
</script>