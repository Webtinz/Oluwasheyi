<div class="row">
  <section class="content">
    <div class="row">
      <div class="col p-5">
        <div class="card card-primary p-4">
          <h3>Nouveau Departments</h3>
          <div class="card-body">
            <form id="departmentForm">
              <div class="form-group mb-3">
                <label for="nom">Nom du Department</label>
                <input type="text" class="form-control" name="nom" id="nom"
                  required />
              </div>
              <div class="form-group mb-3">
                <label for="nom">Nom du Department (Anglais) </label>
                <input type="text" class="form-control" name="nom_en" id="nom"
                  required />
              </div>
              <div class="form-group mb-3">
                <label for="email">Email</label>
                <input type="email" class="form-control" name="email" id="email"
                  required />
              </div>
              <div class="form-group mb-3">
                <label for="phone">Phone</label>
                <input type="tel" class="form-control" name="phone" id="phone"
                  required />
              </div>
              <div class="form-group mb-3">
                <label for="description">Description</label>
                <textarea class="form-control" name="description"
                  id="description" required></textarea>
              </div>
              <div class="form-group mb-3">
                <label for="description">Description (Anglais)</label>
                <textarea class="form-control" name="description_en"
                  id="description" required></textarea>
              </div>
              <div class="form-group mb-3">
                <label for="photo">Photo</label>
                <input type="file" multiple required class="form-control" name="photos"
                  id="photo" />
              </div>
              <button type="submit" class="btn btn-primary">Ajouter
                Departments</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
  // Récupérer le formulaire
  const form = document.getElementById('departmentForm');  // Ajout de la récupération du formulaire

  form.addEventListener('submit', async (event) => {
    event.preventDefault();  // Empêcher la soumission classique du formulaire

    const formData = new FormData(form);

    // Log les données du formulaire avant de les envoyer
    console.log('FormData:', [...formData.entries()]);

    try {
      const response = await axios.post('/api/adddepartment', formData, {
        headers: {
          'Content-Type': 'multipart/form-data'
        }
      });

      console.log('Réponse de l\'API:', response);
      if (response.status === 201) {
        alert(response.data.message);  // Afficher un message de succès
        window.location.href = '/backoffice/listdepartments';
        form.reset();  // Réinitialiser le formulaire
      } else {
        alert('Error: ' + response.data.message);  // Afficher un message d'erreur
      }
    } catch (error) {
      console.log('Erreur lors de l\'ajout du témoignage:', error.response || error);
      alert('Erreur lors de l\'ajout du témoignage');
    }
  });
</script>