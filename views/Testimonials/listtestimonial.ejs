<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<link href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css"
    rel="stylesheet">
<script
    src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Testimonials</h3>
            <div class="card-tools">
                <a href="/backoffice/addtestimonial" class="btn btn-primary"><i
                        class="fas fa-plus"></i>Add
                    Testmonials</a>
            </div>
        </div>
        <div class="card-body">
            <table id="myTable" class="display table table-striped projects">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Image</th>
                        <th>Titre</th>
                        <th>Descritions</th>
                        <th>Address</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Les lignes seront insérées ici via JavaScript -->
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- View/Edit Modal -->
<!-- View/Edit Modal -->
<div class="modal fade" id="testimonialModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Details du Temoignages
                </h5>
                <button type="button" class="close" data-dismiss="modal"
                    aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="testimonialForm">
                    <input type="hidden" id="testimonialId">
                    <div class="form-group">
                        <label>
                            Nom
                        </label>
                        <input type="text" id="testimonialName"
                            class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Titre</label>
                        <input type="text" id="testimonialTitle"
                            class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <textarea id="testimonialDescription"
                            class="form-control" required></textarea>
                    </div>
                    <div class="form-group">
                        <label>Adresse</label>
                        <input type="text" id="testimonialAddress"
                            class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Image</label>
                        <input type="file" class="form-control"
                            name="photo" id="newPhoto">
                        <div id="testimonialImage">
                            <!-- Image preview will go here -->
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        Enregistrer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        axios.get('/api/getalltestimonials')
            .then(response => {
                const data = response.data;
                const tableBody = document.querySelector('#myTable tbody');
                tableBody.innerHTML = '';

                data.forEach(testimonial => {
                    const row = `
                    <tr>
                        <td>${testimonial.id}</td>
                        <td>${testimonial.nom} ${testimonial.prenom}</td>
                        <td><img src="${testimonial.photo}" width="50" height="50" alt="Image"></td>
                        <td>${testimonial.titre}</td>
                        <td>${testimonial.description}</td>
                        <td>${testimonial.address}</td>
                        <td>
                            <button class="btn btn-primary btn-sm view-btn" data-id="${testimonial.id}">Edit</button>
                            <button class="btn btn-danger btn-sm delete-btn" data-id="${testimonial.id}">Delete</button>
                        </td>
                    </tr>`;
                    tableBody.innerHTML += row;
                });

                // Initialize DataTable
                $('#myTable').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/fr-FR.json"
                    }
                });
            })
            .catch(error => console.error('Error fetching testimonials:', error));

        // View testimonial details in modal
        document.body.addEventListener('click', function (e) {
            if (e.target.classList.contains('view-btn')) {
                const id = e.target.dataset.id;
                axios.get(`/api/gettestimonial/${id}`)
                    .then(response => {
                        const testimonial = response.data;
                        document.getElementById('testimonialId').value = testimonial.id;
                        document.getElementById('testimonialName').value = testimonial.nom + ' ' + testimonial.prenom;
                        document.getElementById('testimonialTitle').value = testimonial.titre;
                        document.getElementById('testimonialDescription').value = testimonial.description;
                        document.getElementById('testimonialAddress').value = testimonial.address;

                        // Display the current image in the modal
                        const imageUrl = `${testimonial.photo}`;
                        document.getElementById('testimonialImage').innerHTML = `
                    <img src="${imageUrl}" width="100" height="100" alt="Testimonial Image" class="img-thumbnail">
                    <p>Current Image</p>
                `;

                        $('#testimonialModal').modal('show');
                    })
                    .catch(error => console.error('Error fetching testimonial:', error));
            }
        });

        // Update testimonial
        document.getElementById('testimonialForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const id = document.getElementById('testimonialId').value;
            const data = {
                nom: document.getElementById('testimonialName').value.split(' ')[0],
                prenom: document.getElementById('testimonialName').value.split(' ')[1],
                titre: document.getElementById('testimonialTitle').value,
                description: document.getElementById('testimonialDescription').value,
                address: document.getElementById('testimonialAddress').value,
                photo: document.getElementById('newPhoto').files[0]
            };

            axios.put(`/api/updatetestimonial/${id}`, data, {
                headers: {
                    'Content-Type': 'multipart/form-data'
                }
            })
                .then(() => {
                    $('#testimonialModal').modal('hide');
                    location.reload();
                })
                .catch(error => console.error('Error updating testimonial:', error));
        });

        // Delete testimonial
        document.body.addEventListener('click', function (e) {
            if (e.target.classList.contains('delete-btn')) {
                const id = e.target.dataset.id;
                if (confirm('Are you sure you want to delete this testimonial?')) {
                    axios.delete(`/api/deletetestimonial/${id}`)
                        .then(() => location.reload())
                        .catch(error => console.error('Error deleting testimonial:', error));
                }
            }
        });
    });
</script>